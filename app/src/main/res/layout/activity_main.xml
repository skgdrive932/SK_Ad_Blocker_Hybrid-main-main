<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/navy_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SK / SECURITY" android:textColor="@color/mint" android:textStyle="bold" android:letterSpacing="0.16" android:textSize="12sp" />
        <TextView android:id="@+id/titleText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="SK Ad Blocker" android:textColor="@color/text_primary"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Private DNS protection for your phone" android:textColor="@color/text_secondary" android:textSize="15sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="26dp" android:padding="20dp" android:background="@drawable/card_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PROTECTION STATUS"
                android:textColor="@color/text_secondary" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.08" />
            <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:text="PROTECTION OFF" android:textColor="@color/mint"
                android:textSize="23sp" android:textStyle="bold" />
            <TextView android:id="@+id/detailText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="9dp" android:text="Protection is off. Your phone uses its normal network settings."
                android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="3dp" />
            <Button android:id="@+id/startButton" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="22dp" android:text="Start Protection" android:textAllCaps="false"
                android:textStyle="bold" android:textSize="16sp" android:textColor="@color/navy_bg"
                android:backgroundTint="@color/mint" />
            <Button android:id="@+id/stopButton" android:layout_width="match_parent" android:layout_height="56dp"
                android:layout_marginTop="10dp" android:text="Stop Protection" android:textAllCaps="false"
                android:textStyle="bold" android:textSize="16sp" android:textColor="@color/text_primary"
                android:enabled="false" android:backgroundTint="@color/card_bg" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="16dp" android:padding="18dp" android:background="@drawable/card_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WHAT IT PROTECTS"
                android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="• DNS blocklist for common ad and tracker domains
• Works across apps that use system DNS
• Regular web, downloads and messaging traffic stays outside the VPN tunnel
• Encrypted DNS (DoH/DoT) and same-domain ads may bypass filtering"
                android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="5dp" />
        </LinearLayout>
        <Button android:id="@+id/aboutButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="About SK Ad Blocker" android:textAllCaps="false"
            android:textColor="@color/mint" android:backgroundTint="@color/card_bg" />
        <TextView android:id="@+id/aboutText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:layout_marginTop="8dp" android:padding="18dp" android:background="@drawable/card_background"
            android:text="Developer: Sk kaushal
Email: skgdrive932@gmail.com
Contact: +919779371866

On-device DNS filtering. No HTTPS interception or traffic logging.
License: SK Kaushal Personal License."
            android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp"
            android:gravity="center" android:text="YOUR DEVICE. YOUR NETWORK. YOUR CONTROL."
            android:textColor="@color/text_secondary" android:textSize="10sp" android:letterSpacing="0.08" />
    </LinearLayout>
</ScrollView>
